# Docker: free token from dashboard.ngrok.com (only needed for the tunnel sidecar)
NGROK_AUTHTOKEN=

# Host port Docker binds on (loopback only). Change if 8787 is taken on the server.
APP_BIND_PORT=8787

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://voice-api.example.ca
DATABASE_PATH=./data/pillar9-voice.sqlite
AUTO_SEED=true
ADMIN_API_KEY=replace-with-at-least-24-random-characters
TOOL_API_KEY=replace-with-another-24-random-characters
LOG_LEVEL=info

# Small internal demo panel at /demo; never reuse ADMIN_API_KEY here
DEMO_PANEL_ENABLED=true
DEMO_PANEL_API_KEY=replace-with-a-separate-demo-only-key
DEMO_PANEL_ALLOW_LIVE_CALLS=false

# Voice provider: "retell" (default) or "bland"
VOICE_PROVIDER=retell

# Retell AI. RETELL_API_KEY also verifies inbound webhook signatures.
RETELL_API_BASE_URL=https://api.retellai.com
RETELL_API_KEY=
# The key Retell marks "Webhook Key" in Settings -> API Keys. Blank falls back to RETELL_API_KEY.
RETELL_WEBHOOK_KEY=
RETELL_DRY_RUN=true
RETELL_AGENT_ID=
RETELL_AGENT_VERSION=
RETELL_LLM_ID=
# Speaking rate: 0.5 slowest, 1 default, 2 fastest
RETELL_VOICE_SPEED=1
RETELL_LLM_MODEL=gpt-4.1
RETELL_VOICE_ID=retell-Cimo  # or a custom_voice_* id from Retell → Voices
RETELL_FROM_NUMBER=+12365009709
RETELL_INBOUND_NUMBER=+12365009709
RETELL_RECORD_CALLS=false
RETELL_TIMEOUT_MS=30000

# Bland AI
BLAND_API_BASE_URL=https://api.bland.ai
BLAND_API_KEY=
BLAND_WEBHOOK_SECRET=
BLAND_DRY_RUN=true
BLAND_FROM_NUMBER=+14035550100
BLAND_INBOUND_NUMBER=+14035550100
BLAND_VOICE=Paige
BLAND_PATHWAY_ID=
BLAND_PATHWAY_VERSION=staging
BLAND_TOOL_IDS=
BLAND_KNOWLEDGE_BASE_IDS=
BLAND_RECORD_CALLS=false
BLAND_GENERATE_PATHWAY=false
BLAND_PURCHASE_NUMBER=false
BLAND_AREA_CODE=403

# Identity and licensed handoffs
SERVICE_NAME=Pillar 9
ASSISTANT_NAME=Ava
LICENSED_AGENT_ID=agent_001
LICENSED_AGENT_NAME=Alex Chen
LICENSED_AGENT_LICENSE_NUMBER=RECA-REPLACE-ME
BROKERAGE_NAME=Example Realty
TRANSFER_PHONE_NUMBER=+14035550101
MORTGAGE_TRANSFER_PHONE_NUMBER=+14035550102
DEFAULT_TIMEZONE=America/Edmonton

# Relink/Zeus + Matrix adapter; fixture is development-only
MATRIX_MODE=fixture
MATRIX_BASE_URL=
MATRIX_API_KEY=
MATRIX_TIMEOUT_MS=6000
APPROVED_LISTING_HOSTS=listings.example.ca

# OpenAI Responses API for WhatsApp natural-language replies
OPENAI_ENABLED=false
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=350

# Meta WhatsApp Cloud API; v26.0 was the current Graph version on 2026-08-30
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en_CA
WHATSAPP_TEMPLATE_BIRTHDAY=p9_birthday_v1
WHATSAPP_TEMPLATE_PROPERTY_MATCHES=p9_property_matches_v1
WHATSAPP_TEMPLATE_BUYER_FOLLOWUP=p9_buyer_followup_v1
WHATSAPP_TEMPLATE_SHOWING_FOLLOWUP=p9_showing_followup_v1
WHATSAPP_TEMPLATE_RELATIONSHIP_CHECKIN=p9_relationship_checkin_v1
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=p9_appointment_reminder_v1

# Messaging adapter
MESSAGING_MODE=log
MESSAGING_WEBHOOK_URL=
MESSAGING_API_KEY=
UNSUBSCRIBE_URL=https://listings.example.ca/unsubscribe

# External Canadian compliance/DNCL decision service; fixture is development-only
COMPLIANCE_MODE=fixture
COMPLIANCE_BASE_URL=
COMPLIANCE_API_KEY=

# Conservative contact-local windows
CALL_WINDOW_START=09:00
CALL_WINDOW_END=20:00
WEEKEND_CALL_WINDOW_START=10:00
WEEKEND_CALL_WINDOW_END=18:00
MAX_CALL_DURATION_MINUTES=12
CONSENT_MAX_AGE_DAYS=365
